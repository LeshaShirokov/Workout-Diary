{
  "id": "/Workout-Diary/",
  "name": "Дневник тренировок",
  "short_name": "Дневник",
  "description": "Дневник силовых тренировок: программа по дням, подходы и веса, таймер отдыха, прогресс и рекорды. Работает без интернета, данные хранятся только на устройстве.",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f3f4fb",
  "theme_color": "#f3f4fb",
  "categories": ["health", "fitness", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Начать тренировку",
      "short_name": "Тренировка",
      "description": "Продолжить незавершённую или начать следующий день программы",
      "url": "./#/today?start=1",
      "icons": [{ "src": "icons/shortcut-start.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Журнал",
      "short_name": "Журнал",
      "description": "Календарь и история тренировок",
      "url": "./#/journal",
      "icons": [{ "src": "icons/shortcut-journal.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Прогресс",
      "short_name": "Прогресс",
      "description": "Графики весов, объёма и рекорды",
      "url": "./#/progress",
      "icons": [{ "src": "icons/shortcut-progress.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "screenshots": [
    { "src": "screenshots/today-narrow.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Сегодня: выбор дня программы и старт тренировки" },
    { "src": "screenshots/session-narrow.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Тренировка: подходы, веса и таймер отдыха" },
    { "src": "screenshots/progress-wide.png", "sizes": "1366x768", "type": "image/png", "form_factor": "wide", "label": "Прогресс: графики и личные рекорды" }
  ]
}
